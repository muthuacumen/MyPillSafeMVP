# ──────────────────────────────────────────────────────────────────────────────
# MyPillSafe — PRODUCTION environment template (Task A5.3, mypillsafe.ca)
# PLACEHOLDERS ONLY. Copy to `.env` at the REPO ROOT on the droplet and fill
# in real values there (DEPLOY_GUIDE.md §7.2). The filename must be exactly
# `.env`: the base compose file hardcodes the service-level `env_file: ../.env`
# path, so any other name (e.g. `.env.production`) makes compose fail with
# "env file not found". NEVER commit the filled-in file -- .gitignore carries
# exact-match entries for both `.env` and `.env.production` (verify with
# DEPLOY_GUIDE.md §1.1's secrets sweep before pushing). Used as:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml
#     --env-file .env up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=0.1.0
# Generate a real 256-bit secret (e.g. `openssl rand -hex 32`) -- never reuse
# the dev default or check a real value into any tracked file.
SECRET_KEY=<generate-a-strong-random-256-bit-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL, via docker-compose.yml's postgres service) ─────────
POSTGRES_DB=pillsafe
POSTGRES_USER=pillsafe_user
POSTGRES_PASSWORD=<generate-a-strong-random-password>

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://mypillsafe.ca

# ── Feature Flags ─────────────────────────────────────────────────────────────
# OpenAPI/Swagger UI must be OFF in production -- don't expose the schema
# (and every route's shape) to the public internet.
OPENAPI_ENABLED=false
ML_PIPELINE_ENABLED=false
# Real sidecar-backed prescription OCR. MUST stay true in production --
# `false` fabricates prescription text regardless of what was actually
# photographed (an explicit LOCAL-DEV-ONLY opt-out; see
# app/api/v1/routes/prescriptions.py's module docstring). A real OCR
# failure with this flag on returns an honest 503 OCR_UNAVAILABLE instead --
# never silently invent a prescription in production.
OCR_PIPELINE_ENABLED=true

# ── Brains sidecar pool (Task A3) ─────────────────────────────────────────────
# Up to five team laptops may each run `dev/brains` -- BRAINS_SERVICE_URLS is
# a comma-separated pool, health-checked every request (2s timeout, 30s
# cache) so one closed laptop doesn't take the demo down. Replace with real
# Tailscale IPs (100.x.y.z) for whichever laptops are actually up -- NEVER a
# MagicDNS hostname (containers use Docker's resolver, not the tailnet's).
BRAINS_SERVICE_URLS=http://100.x.y.z:8100,http://100.a.b.c:8100
# Single-URL fallback, used only if BRAINS_SERVICE_URLS is ever empty (back-
# compat path, see app/services/brains_registry.py rule 1) -- keep this in
# sync with the first pool entry above so a misconfigured/empty pool still
# degrades to a real host instead of the dev-only 127.0.0.1 default.
BRAINS_SERVICE_URL=http://100.x.y.z:8100
PILL_V2_ENABLED=true

# ── CB4 -- the production voice for BB3 Q&A (app/services/cb4_service.py) ───
# Blank LLM_API_KEY falls back to the sidecar's local-7B offline answer
# (requires Ollama running on whichever laptop is serving -- not the
# intended production path). Set a real key here for the CB4 cloud voice.
# Only cited monograph context is ever sent to the model -- never raw images.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Image tag (docker-compose.prod.yml) ───────────────────────────────────────
# Which GHCR-published backend/frontend image tag to pull. `latest` for the
# most recent CI build, or a specific commit-sha/version tag to pin a
# release.
IMAGE_TAG=latest
