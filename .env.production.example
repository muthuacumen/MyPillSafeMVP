# ──────────────────────────────────────────────────────────────────────────────
# MyPillSafe — PRODUCTION environment template (Task A5.3, mypillsafe.ca)
# PLACEHOLDERS ONLY. Copy to `.env` at the REPO ROOT on the droplet and fill
# in real values there (DEPLOY_GUIDE.md §7.2). The filename must be exactly
# `.env`: the base compose file hardcodes the service-level `env_file: ../.env`
# path, so any other name (e.g. `.env.production`) makes compose fail with
# "env file not found". NEVER commit the filled-in file -- .gitignore carries
# exact-match entries for both `.env` and `.env.production` (verify with
# DEPLOY_GUIDE.md §1.1's secrets sweep before pushing). Used as:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml
#     --env-file .env up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=0.1.0
# Generate a real 256-bit secret (e.g. `openssl rand -hex 32`) -- never reuse
# the dev default or check a real value into any tracked file.
SECRET_KEY=<generate-a-strong-random-256-bit-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL, via docker-compose.yml's postgres service) ─────────
POSTGRES_DB=pillsafe
POSTGRES_USER=pillsafe_user
POSTGRES_PASSWORD=<generate-a-strong-random-password>

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://mypillsafe.ca

# ── Registration gating ───────────────────────────────────────────────────────
# Keep true in production. Registration is open to the public internet, and
# with a real LLM_API_KEY set below, an unapproved account is someone else
# spending Anthropic tokens. Approval is the gate. /auth/register returns 202
# and issues no tokens; the account cannot sign in until an admin approves it
# in Admin -> Users.
REQUIRE_ADMIN_APPROVAL=true
# THE ONLY WAY TO GET AN ADMIN IN PRODUCTION -- /dev/seed-admin 404s whenever
# APP_ENV != development. Order of operations on a fresh deploy:
#   1. bring the stack up  2. register normally at https://mypillsafe.ca/register
#   3. put that same address here  4. restart the backend container
#   5. sign in -- the account is now an active ADMIN
# Comma-separated for more than one. Promotion is idempotent, so it is safe on
# every subsequent restart, and an address with no account yet is a logged
# no-op that gets picked up on a later restart.
ADMIN_EMAILS=<your-admin-email@example.com>

# ── Contact-form email (app/services/mail_service.py) ────────────────────────
# Optional. Leave blank and /contact still works exactly as before: 201 plus a
# line appended to {UPLOAD_DIR}/contact_messages.jsonl, which remains the
# system of record. Filling these in adds an email notification on top; a
# failed or slow send is logged and swallowed and never reaches the visitor.
# mypillsafe.ca's MX and SPF both point at IONOS, so IONOS SMTP is the natural
# choice -- any relay works. Put the real password ONLY in this file on the
# droplet (`.env`, chmod 600, gitignored). It is never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@mypillsafe.ca
SMTP_PASSWORD=<mailbox-password-or-app-password>
SMTP_FROM=info@mypillsafe.ca
SMTP_STARTTLS=true
CONTACT_TO=info@mypillsafe.ca

# ── Feature Flags ─────────────────────────────────────────────────────────────
# OpenAPI/Swagger UI must be OFF in production -- don't expose the schema
# (and every route's shape) to the public internet.
OPENAPI_ENABLED=false
ML_PIPELINE_ENABLED=false
# Real sidecar-backed prescription OCR. MUST stay true in production --
# `false` fabricates prescription text regardless of what was actually
# photographed (an explicit LOCAL-DEV-ONLY opt-out; see
# app/api/v1/routes/prescriptions.py's module docstring). A real OCR
# failure with this flag on returns an honest 503 OCR_UNAVAILABLE instead --
# never silently invent a prescription in production.
OCR_PIPELINE_ENABLED=true

# Rx PARSING (FixbyOPUS3). Both values below are already the `config.py`
# defaults, so a deploy that omits them behaves correctly -- they are spelled
# out here because a fresh deploy would otherwise never learn the knobs exist.
# `false` (or RX_PARSE_BACKEND=regex) is the kill-switch: the deterministic
# regex parser proposes instead of the sidecar's local qwen2.5:7b. Either way
# the SAME guardrails (G1-G6) and the SAME server-side time derivation run --
# the flag changes who proposes, never which safety rules apply. A 'haiku'
# backend is DOCUMENTED but NOT IMPLEMENTED (measured better on the
# 2026-07-28 evaluation; recorded as a finding, not used for Rx reading).
RX_LLM_PARSE_ENABLED=true
RX_PARSE_BACKEND=qwen

# Tray scan (MPR1-T04/T34pre). Default off -- set true only once the
# production sidecar actually serves /tray/analyze (see config.py's
# TRAY_ANALYZE_ENABLED docstring); off returns 501 on /api/v1/tray/analyze.
TRAY_ANALYZE_ENABLED=false

# ── Sidecar Supervisor proxy (Task T2) ────────────────────────────────────────
# A separate service (dev/ops, its own port -- NOT this backend) that actually
# starts/stops/warms the dev/brains sidecar process and reports host resources
# (free RAM, AC power). Admin -> Sidecar in the frontend calls this backend's
# /api/v1/admin/sidecar/{status,start,stop}, which is a thin admin-gated PROXY
# forwarding to {SUPERVISOR_URL}{/status,/start,/stop} with this bearer token
# and passing the Supervisor's response straight through. Point this at
# wherever the Supervisor actually runs for this deployment -- likely the
# same host as whichever sidecar it manages, so this may need to change
# alongside BRAINS_SERVICE_URL(S) below rather than staying at 127.0.0.1.
SUPERVISOR_URL=http://127.0.0.1:8090
# Sent as `Authorization: Bearer <token>` on every Supervisor call. Set a
# real shared secret once the Supervisor enforces one -- do not ship a
# production Supervisor with no auth and leave this blank.
SUPERVISOR_TOKEN=<generate-a-shared-secret-matching-the-supervisors-config>

# ── Public sidecar-status ticker (no auth, GET /api/v1/status/sidecar) ───────
# What the frontend ticker shows the instant it reads the sidecar's own
# /health state -- reuses app/services/brains_registry.py's existing health
# check, cached 20s in-process so ticker polling never hits the sidecar on
# every request.
SIDECAR_UP_MESSAGE=PillSafe analysis engine is online — demo ready.
SIDECAR_DOWN_MESSAGE=Analysis engine is offline. For demo/starting sidecar, please contact admin at info@mypillsafe.ca

# ── Brains sidecar pool (Task A3) ─────────────────────────────────────────────
# Up to five team laptops may each run `dev/brains` -- BRAINS_SERVICE_URLS is
# a comma-separated pool, health-checked every request (2s timeout, 30s
# cache) so one closed laptop doesn't take the demo down. Replace with real
# Tailscale IPs (100.x.y.z) for whichever laptops are actually up -- NEVER a
# MagicDNS hostname (containers use Docker's resolver, not the tailnet's).
BRAINS_SERVICE_URLS=http://100.x.y.z:8100,http://100.a.b.c:8100
# Single-URL fallback, used only if BRAINS_SERVICE_URLS is ever empty (back-
# compat path, see app/services/brains_registry.py rule 1) -- keep this in
# sync with the first pool entry above so a misconfigured/empty pool still
# degrades to a real host instead of the dev-only 127.0.0.1 default.
BRAINS_SERVICE_URL=http://100.x.y.z:8100
PILL_V2_ENABLED=true

# ── CB4 -- the production voice for BB3 Q&A (app/services/cb4_service.py) ───
# Blank LLM_API_KEY falls back to the sidecar's local-7B offline answer
# (requires Ollama running on whichever laptop is serving -- not the
# intended production path). Set a real key here for the CB4 cloud voice.
# Only cited monograph context is ever sent to the model -- never raw images.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Image tag (docker-compose.prod.yml) ───────────────────────────────────────
# Which GHCR-published backend/frontend image tag to pull. `latest` for the
# most recent CI build, or a specific commit-sha/version tag to pin a
# release.
IMAGE_TAG=latest
