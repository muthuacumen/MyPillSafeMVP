# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=your-256-bit-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pillsafe
POSTGRES_USER=pillsafe_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://pillsafe_user:change_me_in_production@postgres:5432/pillsafe

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT=10/minute

# ── Feature Flags ─────────────────────────────────────────────────────────────
OPENAPI_ENABLED=true
ML_PIPELINE_ENABLED=false     # Set true when Sprint 4 models are ready
OCR_PIPELINE_ENABLED=false    # Set true once paddleocr/paddlepaddle are installed (Priority 1B)

# ── Claude API guidance layer (Priority 7, optional) ─────────────────────────
# Leave blank to keep the guidance layer inert (pill analysis still works,
# just without the plain-language description). Only structured attributes
# (color/shape/imprint) are ever sent — never raw images or PHI.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Docker Hub (optional — only needed if you push images yourself) ──────────
# Never commit a real token. Generate your own at hub.docker.com → Account
# Settings → Security → Personal Access Tokens, and keep it in your local
# .env only (already gitignored).
# DOCKER_HUB_USERNAME=<your-dockerhub-username>
# DOCKER_HUB_PAT=<your-personal-access-token>
