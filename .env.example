# ── Application ──────────────────────────────────────────────────────────────
# Every var below is read by dev/backend/app/core/config.py's Settings class
# unless a comment says otherwise. Copy this file to `.env` at the repo root
# (docker-compose reads it from there) and/or to dev/backend/.env (config.py
# also looks one/two directories up, so a repo-root .env is picked up either
# way -- see LOCAL_TESTING.md for the non-Docker run story).
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=your-256-bit-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# Local/non-Docker default (LOCAL_TESTING.md run story): SQLite, file lives
# next to dev/backend/ -- leave DATABASE_URL unset to use it as-is.
# DATABASE_URL=sqlite+aiosqlite:///./pillsafe.db
#
# Docker Compose only: docker/docker-compose.yml overrides DATABASE_URL
# itself to point at the postgres service below, built from these three vars
# (they matter for `make dev`/`make dev-bg`, not the local/no-docker story).
POSTGRES_DB=pillsafe
POSTGRES_USER=pillsafe_user
POSTGRES_PASSWORD=change_me_in_production

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Feature Flags ─────────────────────────────────────────────────────────────
OPENAPI_ENABLED=true
# Gates the legacy /api/v1/analyze stub endpoint (pre-dates the IMB1/SB2
# pill-scan pipeline; not called by the current frontend) -- leave false.
ML_PIPELINE_ENABLED=false
# Real PaddleOCR prescription-label parsing. Leave true -- off means every
# upload silently returns canned demo text regardless of the photo.
OCR_PIPELINE_ENABLED=true

# ── Brains sidecar (dev/brains/ -- IMB1 + SB2 + BB3 over HTTP) ───────────────
# Host-run FastAPI microservice, own venv/port -- see LOCAL_TESTING.md /
# `make brains`. Point this at wherever it's actually running: 127.0.0.1 for
# a local non-Docker backend, http://host.docker.internal:8100 when the
# BACKEND runs in Docker (docker-compose.yml sets that override itself).
BRAINS_SERVICE_URL=http://127.0.0.1:8100
# /analyze/pill/v2 is the only pill-scan endpoint (Phase 3 removed the legacy
# OpenCV path entirely) -- this is now a pure kill-switch, default on.
PILL_V2_ENABLED=true

# ── CB4 -- the production voice for BB3 Q&A (app/services/cb4_service.py) ───
# Cloud call ONLY when LLM_API_KEY is non-empty. Leave blank to fall back to
# the brains sidecar's local-7B offline answer (needs `ollama serve` +
# qwen2.5:7b-instruct running separately -- never required for the CB4 path).
# Only cited monograph context is ever sent to the model -- never raw images.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Docker Hub (optional — only needed if you push images yourself) ──────────
# Never commit a real token. Generate your own at hub.docker.com → Account
# Settings → Security → Personal Access Tokens, and keep it in your local
# .env only (already gitignored).
# DOCKER_HUB_USERNAME=<your-dockerhub-username>
# DOCKER_HUB_PAT=<your-personal-access-token>
