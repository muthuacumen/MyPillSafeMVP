# ── Application ──────────────────────────────────────────────────────────────
# Every var below is read by dev/backend/app/core/config.py's Settings class
# unless a comment says otherwise. Copy this file to `.env` at the repo root
# (docker-compose reads it from there) and/or to dev/backend/.env (config.py
# also looks one/two directories up, so a repo-root .env is picked up either
# way -- see LOCAL_TESTING.md for the non-Docker run story).
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=your-256-bit-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# Local/non-Docker default (LOCAL_TESTING.md run story): SQLite, file lives
# next to dev/backend/ -- leave DATABASE_URL unset to use it as-is.
# DATABASE_URL=sqlite+aiosqlite:///./pillsafe.db
#
# Docker Compose only: docker/docker-compose.yml overrides DATABASE_URL
# itself to point at the postgres service below, built from these three vars
# (they matter for `make dev`/`make dev-bg`, not the local/no-docker story).
POSTGRES_DB=pillsafe
POSTGRES_USER=pillsafe_user
POSTGRES_PASSWORD=change_me_in_production

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Registration gating ───────────────────────────────────────────────────────
# true (default): every new signup is created INACTIVE and /auth/register
# returns 202 with no tokens. The person cannot sign in until an admin hits
# Approve in Admin -> Users (which is the existing activate endpoint). Trying
# to log in before then returns 403 ACCOUNT_PENDING_APPROVAL -- but ONLY after
# the password has been verified, so the endpoint never becomes a way to test
# which email addresses have accounts.
# false: the kill-switch -- back to 201 + tokens + immediate sign-in.
# This rides on the EXISTING users.is_active column on purpose. No new column,
# no migration -- see the 2026-07-30 UndefinedColumn outage.
REQUIRE_ADMIN_APPROVAL=true
# Comma-separated, case-insensitive. Every matching EXISTING account is
# promoted to ADMIN and reactivated on every app start. It PROMOTES, it never
# CREATES -- register through the normal form first, then restart the backend.
# This is the only way to mint an admin in production: /dev/seed-admin 404s
# unless APP_ENV=development.
ADMIN_EMAILS=

# ── Contact-form email (app/services/mail_service.py) ────────────────────────
# Entirely optional and inert while blank: with no SMTP_HOST/SMTP_USER/
# SMTP_PASSWORD nothing is sent and no socket is opened. /contact still returns
# 201 and still appends to {UPLOAD_DIR}/contact_messages.jsonl, which is the
# system of record -- the mailbox is only a notification. Works with any relay
# (mypillsafe.ca's MX is IONOS; a Gmail app password works too).
# NEVER commit a real password here -- this file is the template, `.env` is
# gitignored.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender. Falls back to SMTP_USER when blank.
SMTP_FROM=
SMTP_STARTTLS=true
# Where contact submissions are delivered. Reply-To is set to the submitter,
# so replying from this mailbox reaches the person who wrote in.
CONTACT_TO=info@mypillsafe.ca

# ── Feature Flags ─────────────────────────────────────────────────────────────
OPENAPI_ENABLED=true
# Real PaddleOCR prescription-label parsing. Leave true -- off means every
# upload silently returns canned demo text regardless of the photo.
OCR_PIPELINE_ENABLED=true

# ── Brains sidecar (dev/brains/ -- IMB1 + SB2 + BB3 over HTTP) ───────────────
# Host-run FastAPI microservice, own venv/port -- see LOCAL_TESTING.md /
# `make brains`. Point this at wherever it's actually running: 127.0.0.1 for
# a local non-Docker backend, http://host.docker.internal:8100 when the
# BACKEND runs in Docker (docker-compose.yml sets that override itself).
BRAINS_SERVICE_URL=http://127.0.0.1:8100
# /analyze/pill/v2 is the only pill-scan endpoint (Phase 3 removed the legacy
# OpenCV path entirely) -- this is now a pure kill-switch, default on.
PILL_V2_ENABLED=true

# ── Rx parsing (FixbyOPUS3) ──────────────────────────────────────────────────
# Who PROPOSES the medications read off a prescription label. The safety layer
# is NOT part of this choice: the deterministic guardrails
# (app/services/rx_guardrails.py) and the server-side reminder-time derivation
# run on every proposal from every proposer, always. Flipping these changes
# who proposes, never which rules apply -- and nothing is ever committed to a
# user's schedule without their explicit approval either way.
#
# true (default) -> the brains sidecar's POST /rx/extract, local
#   qwen2.5:7b-instruct via Ollama on the sidecar host. Needs `ollama serve`
#   + `ollama pull qwen2.5:7b-instruct` there; check GET /health's
#   "rx_extract" field. If the sidecar or Ollama is unreachable the backend
#   falls back to the deterministic regex parser automatically and says so in
#   the response's `parse_source` -- honest degradation, never a fabricated
#   prescription.
# false -> skip the model entirely and use the regex parser (still guarded).
RX_LLM_PARSE_ENABLED=true
# 'qwen' (default) | 'regex'. A future 'haiku' value is documented but NOT
# implemented: Claude Haiku 4.5 measured strictly better on the 2026-07-28
# evaluation (12/12 labels, 50/50 fields, 0 safety events, vs qwen's 11/12,
# 49/50, 0) and is recorded as a finding, not wired as a dependency -- see
# documentation/evaluation/rx_parsing/README.md.
RX_PARSE_BACKEND=qwen

# ── Sidecar Supervisor proxy (Task T2) ────────────────────────────────────────
# A separate service (dev/ops, its own port -- NOT this backend) that actually
# starts/stops/warms the dev/brains sidecar process and reports host resources
# (free RAM, AC power). Admin -> Sidecar in the frontend calls this backend's
# /api/v1/admin/sidecar/{status,start,stop}, which is a thin admin-gated PROXY
# forwarding to {SUPERVISOR_URL}{/status,/start,/stop} with this bearer token
# and passing the Supervisor's response straight through.
SUPERVISOR_URL=http://127.0.0.1:8090
# Sent as `Authorization: Bearer <token>` on every Supervisor call. Blank
# works against a local Supervisor with no auth configured (the dev default).
SUPERVISOR_TOKEN=

# ── Public sidecar-status ticker (no auth, GET /api/v1/status/sidecar) ───────
# What the frontend ticker shows the instant it reads the sidecar's own
# /health state -- reuses app/services/brains_registry.py's existing health
# check, cached 20s in-process so ticker polling never hits the sidecar on
# every request.
SIDECAR_UP_MESSAGE=PillSafe analysis engine is online — demo ready.
SIDECAR_DOWN_MESSAGE=Analysis engine is offline. For demo/starting sidecar, please contact admin at info@mypillsafe.ca

# ── CB4 -- the production voice for BB3 Q&A (app/services/cb4_service.py) ───
# Cloud call ONLY when LLM_API_KEY is non-empty. Leave blank to fall back to
# the brains sidecar's local-7B offline answer (needs `ollama serve` +
# qwen2.5:7b-instruct running separately -- never required for the CB4 path).
# Only cited monograph context is ever sent to the model -- never raw images.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Docker Hub (optional — only needed if you push images yourself) ──────────
# Never commit a real token. Generate your own at hub.docker.com → Account
# Settings → Security → Personal Access Tokens, and keep it in your local
# .env only (already gitignored).
# DOCKER_HUB_USERNAME=<your-dockerhub-username>
# DOCKER_HUB_PAT=<your-personal-access-token>
